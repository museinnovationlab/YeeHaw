rules_version = '2';

// YeeHaw Firestore security rules.
//
// All app reads/writes go through the server (Firebase Admin SDK), which BYPASSES
// these rules. So the client is locked down hard: it only needs read access to
// PUBLISHED posts (in case we ever read them directly from the browser), and
// nothing else. Subscribers, drafts, campaigns, and jobs are server-only.

service cloud.firestore {
  match /databases/{database}/documents {

    // Published posts are world-readable; no client writes.
    match /posts/{postId} {
      allow read: if resource.data.status == 'published';
      allow write: if false;
    }

    // Everything else: no client access at all (server Admin SDK only).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
